# === Primary Domains ===

dz-tracker.ru {
	reverse_proxy studyflow:80
}

uchim-stihi.ru {
	reverse_proxy learn-poetry:3000
}

# === Landing Page ===

projects.dmdp.ru {
	reverse_proxy projects-placeholder:80
}

# === Static Sites (served by Caddy file_server) ===

english-training.dmdp.ru {
	root * /srv/static/english-training
	@blocked {
		path /android/* /node_modules/* /package.json /package-lock.json /capacitor.config.json /.*
	}
	respond @blocked 404
	file_server
	encode gzip
}

math-training.dmdp.ru {
	root * /srv/static/math-training
	@blocked {
		path /android/* /node_modules/* /package.json /package-lock.json /capacitor.config.json /.*
	}
	respond @blocked 404
	file_server
	encode gzip
}

russkij-yazyk.dmdp.ru {
	root * /srv/static/russkij-yazyk
