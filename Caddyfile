# === Client-Side Builds (Docker containers) ===

gift-planner.dmdp.ru {
	reverse_proxy gift-planner:80
}

netwalk-game.dmdp.ru {
	reverse_proxy netwalk-game:80
}

# === Full-Stack Applications ===

excel2markdown.dmdp.ru {
	reverse_proxy excel2md-nginx:80
}

craft-picker.dmdp.ru {
	handle /api/* {
		reverse_proxy craft-picker-backend:8000
	}
	handle {
		reverse_proxy craft-picker-frontend:3000
	}
}

money-envelope.dmdp.ru {
	handle /api/* {
		reverse_proxy money-envelope-backend:8000
	}
	handle {
		reverse_proxy money-envelope-frontend:80
	}
}

# === Redirects (old subdomains) ===

